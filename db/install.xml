<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/mtssdashboard/db" VERSION="20260814" COMMENT="XMLDB file for Moodle mod/mtssdashboard"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="mtssdashboard" COMMENT="Each instance of the State Test View resource added to a course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course this instance belongs to"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Name of this resource instance"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional introduction text"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Format of the intro field"/>
        <FIELD NAME="defaultyear" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Default testing year to display"/>
        <FIELD NAME="defaultsubject" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Default subject code to display"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_warning_levels" COMMENT="Configurable early warning thresholds per school level and metric.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="schoollevel" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="School level: hs, ms, or es."/>
        <FIELD NAME="metric_key" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Stable identifier for the metric (e.g., total_hours_missed)."/>
        <FIELD NAME="color" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="Threshold band color: green, yellow, orange, red, purple."/>
        <FIELD NAME="threshold_min" TYPE="number" LENGTH="10" NOTNULL="false" SEQUENCE="false" DECIMALS="2" COMMENT="Inclusive lower bound for the band; NULL means no lower bound."/>
        <FIELD NAME="threshold_max" TYPE="number" LENGTH="10" NOTNULL="false" SEQUENCE="false" DECIMALS="2" COMMENT="Inclusive upper bound for the band; NULL means no upper bound."/>
        <FIELD NAME="threshold_text" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Optional human-friendly threshold label override."/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Display order within a metric."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="schoollevel_metric" UNIQUE="false" FIELDS="schoollevel, metric_key, sortorder"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_rimp" COMMENT="RIMP records created and edited by teachers for enrolled students.">
      <FIELDS>
        <FIELD NAME="id"                   TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="studentnumber"        TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="District student ID (idnumber from mdl_user)."/>
        <FIELD NAME="schoollevel"          TYPE="char" LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="es, ms, or hs."/>
        <FIELD NAME="schoolyear"           TYPE="char" LENGTH="20"  NOTNULL="false" SEQUENCE="false" COMMENT="School year label, e.g. 2025-2026."/>
        <FIELD NAME="rimp_effective_date"  TYPE="int"  LENGTH="10"  NOTNULL="false" SEQUENCE="false" COMMENT="Unix timestamp of RIMP effective date."/>
        <FIELD NAME="student_score"        TYPE="int"  LENGTH="10"  NOTNULL="false" SEQUENCE="false" COMMENT="iReady or OST scale score used for placement."/>
        <FIELD NAME="assessment_status"    TYPE="char" LENGTH="50"  NOTNULL="false" SEQUENCE="false" COMMENT="On Track or Not On Track."/>
        <FIELD NAME="goals"                TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of goal identifiers."/>
        <FIELD NAME="supports"             TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of instructional support identifiers."/>
        <FIELD NAME="days_per_week"        TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="minutes_per_week"     TYPE="int"  LENGTH="5"   NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="monitoring_assessment" TYPE="text"             NOTNULL="false" SEQUENCE="false" COMMENT="Assessment used for progress monitoring."/>
        <FIELD NAME="monitoring_frequency" TYPE="char" LENGTH="50"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="monitored_by"         TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grade3_guarantee"     TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Third-grade reading guarantee selection (ES only)."/>
        <FIELD NAME="sig_parent"           TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sig_teacher"          TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sig_ela_teacher"      TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="MS ELA teacher signature line."/>
        <FIELD NAME="sig_intervention"     TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="MS intervention teacher signature line."/>
        <FIELD NAME="status"               TYPE="int"  LENGTH="1"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false" COMMENT="0=Draft, 1=Finalized."/>
        <FIELD NAME="timecreated"          TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified"         TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified"         TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary"  FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign"  FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_studentnumber" UNIQUE="false" FIELDS="studentnumber"/>
        <INDEX NAME="idx_status"        UNIQUE="false" FIELDS="studentnumber, status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_rimp_import" COMMENT="Staging table for district RIMP CSV imports.">
      <FIELDS>
        <FIELD NAME="id"                TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="studentnumber"     TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="firstname"         TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lastname"          TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="gender"            TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="current_school"    TYPE="char" LENGTH="200" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="current_grade"     TYPE="int"  LENGTH="3"   NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="student_status"    TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="plan_status"       TYPE="char" LENGTH="20"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="last_modified"     TYPE="char" LENGTH="50"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="student_score"     TYPE="int"  LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="assessment_status" TYPE="char" LENGTH="50"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="effective_date"    TYPE="char" LENGTH="30"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="goals"             TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="supports"          TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="days_per_week"     TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="minutes_per_week"  TYPE="int"  LENGTH="5"   NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="monitoring_freq"   TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="monitored_by"      TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grade3_select"     TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sig_parent"        TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sig_teacher"       TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="schoollevel"       TYPE="char" LENGTH="10"  NOTNULL="true"  DEFAULT="es" SEQUENCE="false"/>
        <FIELD NAME="timeimported"      TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0"  SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_imp_studentnumber" UNIQUE="false" FIELDS="studentnumber"/>
        <INDEX NAME="idx_imp_level"         UNIQUE="false" FIELDS="schoollevel, studentnumber"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_wep" COMMENT="WEP (Written Education Plan) records for gifted students, created and edited by teachers.">
      <FIELDS>
        <FIELD NAME="id"                        TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="studentnumber"             TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="District student ID (idnumber from mdl_user)."/>
        <FIELD NAME="schoollevel"               TYPE="char" LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="es, ms, or hs."/>
        <FIELD NAME="schoolyear"                TYPE="char" LENGTH="20"  NOTNULL="false" SEQUENCE="false" COMMENT="School year label, e.g. 2025-2026."/>
        <FIELD NAME="wep_review_date"           TYPE="int"  LENGTH="10"  NOTNULL="false" SEQUENCE="false" COMMENT="Unix timestamp of annual review date."/>
        <FIELD NAME="identification_areas"      TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of identification area keys (superior_cognitive, superior_creative, reading_writing, mathematics, science, social_studies)."/>
        <FIELD NAME="service_setting"           TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of service setting / EMIS code keys."/>
        <FIELD NAME="progress_measures"         TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of student progress measure keys."/>
        <FIELD NAME="personnel"                 TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of personnel responsible keys."/>
        <FIELD NAME="goal_reading_writing"      TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="WEP Measurable Annual Reading/Writing Goal."/>
        <FIELD NAME="goal_mathematics"          TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="WEP Measurable Annual Mathematics Goal."/>
        <FIELD NAME="goal_science"              TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="WEP Measurable Annual Science Goal (MS/HS only)."/>
        <FIELD NAME="goal_social_studies"       TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="WEP Measurable Annual Social Studies Goal (MS/HS only)."/>
        <FIELD NAME="midyear_reading"           TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Mid Year Progress - Reading/Writing."/>
        <FIELD NAME="midyear_mathematics"       TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Mid Year Progress - Mathematics."/>
        <FIELD NAME="midyear_science"           TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Mid Year Progress - Science (MS/HS only)."/>
        <FIELD NAME="midyear_social_studies"    TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Mid Year Progress - Social Studies (MS/HS only)."/>
        <FIELD NAME="endofyear_reading"         TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="End of Year Progress - Reading/Writing."/>
        <FIELD NAME="endofyear_mathematics"     TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="End of Year Progress - Mathematics."/>
        <FIELD NAME="endofyear_science"         TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="End of Year Progress - Science (MS/HS only)."/>
        <FIELD NAME="endofyear_social_studies"  TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="End of Year Progress - Social Studies (MS/HS only)."/>
        <FIELD NAME="parent_input"              TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Parent/guardian input narrative."/>
        <FIELD NAME="sig_parent"                TYPE="text"              NOTNULL="false" SEQUENCE="false" COMMENT="Parent/Guardian Representative signature line."/>
        <FIELD NAME="status"                    TYPE="int"  LENGTH="1"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false" COMMENT="0=Draft, 1=Finalized."/>
        <FIELD NAME="timecreated"               TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified"              TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified"              TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_wep_studentnumber" UNIQUE="false" FIELDS="studentnumber"/>
        <INDEX NAME="idx_wep_status"        UNIQUE="false" FIELDS="studentnumber, status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_wep_import" COMMENT="Staging table for district WEP CSV imports.">
      <FIELDS>
        <FIELD NAME="id"                       TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="studentnumber"            TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="firstname"                TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lastname"                 TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="gender"                   TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="current_school"           TYPE="char" LENGTH="200" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="current_grade"            TYPE="int"  LENGTH="3"   NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="student_status"           TYPE="char" LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="plan_status"              TYPE="char" LENGTH="20"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="last_modified"            TYPE="char" LENGTH="50"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="review_date"              TYPE="char" LENGTH="30"  NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="identification_areas"     TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="service_setting"          TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="progress_measures"        TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="personnel"                TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="goal_reading_writing"     TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="goal_mathematics"         TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="goal_science"             TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="goal_social_studies"      TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="midyear_reading"          TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="midyear_mathematics"      TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="midyear_science"          TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="midyear_social_studies"   TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endofyear_reading"        TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endofyear_mathematics"    TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endofyear_science"        TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endofyear_social_studies" TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="parent_input"             TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sig_parent"               TYPE="text"              NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="schoollevel"              TYPE="char" LENGTH="10"  NOTNULL="true"  DEFAULT="es" SEQUENCE="false"/>
        <FIELD NAME="timeimported"             TYPE="int"  LENGTH="10"  NOTNULL="true"  DEFAULT="0"  SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_wep_imp_studentnumber" UNIQUE="false" FIELDS="studentnumber"/>
        <INDEX NAME="idx_wep_imp_level"         UNIQUE="false" FIELDS="schoollevel, studentnumber"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="mtssdashboard_edit_sessions" COMMENT="Tracks which user currently has a RIMP or WEP record open for editing, to prevent two teachers editing the same student's plan at once.">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="studentnumber"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="District student ID (idnumber from mdl_user)."/>
        <FIELD NAME="recordtype"     TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="rimp or wep."/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User currently holding the edit lock."/>
        <FIELD NAME="heartbeat"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of the last heartbeat ping; locks older than the timeout are treated as abandoned."/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid"   TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_edit_sessions_lock" UNIQUE="true" FIELDS="studentnumber, recordtype"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
